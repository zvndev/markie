# Markie API environment. A self-hosted server gets a filled-in copy of this
# from deploy/init.sh; see docs/SELF-HOSTING.md.
PORT=8787
DB_PATH=/data/markie.db
BETTER_AUTH_URL=https://api.markie.example.com
BETTER_AUTH_SECRET=generate-a-long-random-string

# 0 on a self-hosted server (deploy/docker-compose.yml sets it). Unset or 1 is
# the official Markie Cloud, with the release-manifest guards and download routes.
MARKIE_OFFICIAL=0
# Shown in Markie when people add this server. Defaults to the domain.
MARKIE_SERVER_NAME=
# Who may create an account: open, invite or closed. Unset is open on the
# official deployment and invite on a self-hosted one.
MARKIE_SIGNUP=
# The admin's address. Unset: the first account created is the admin.
MARKIE_ADMIN_EMAIL=

# Optional sign-in with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail through Resend, or a Resend-compatible API via RESEND_BASE_URL.
RESEND_API_KEY=
RESEND_BASE_URL=
EMAIL_FROM=Markie <hello@markie.example.com>
# Self-hosted only: no mail, sign-up codes are written to the server log.
MARKIE_MAIL_LOG=

# Any S3-compatible bucket (B2, R2, MinIO, AWS): the encrypted database backup
# and synced media. The official deployment uses the older B2_* (backup) and
# ASSETS_* (media) names instead, which still work.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ASSETS_BUCKET=

# Backup encryption. Required whenever backup storage is set.
LITESTREAM_AGE_IDENTITY=
LITESTREAM_AGE_RECIPIENT=

# Per-account storage quota in bytes. Unset means unlimited.
MARKIE_STORAGE_QUOTA_BYTES=

# Little Friend error and request-timing reports: a secret server key (lfs_...).
# Unset, nothing is sent. Self-hosted servers leave it empty.
LF_SERVER_KEY=
