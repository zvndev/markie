{
  "name": "markie-mobile",
  "version": "0.2.0",
  "private": true,
  "description": "Markie for iOS and Android: open documents from Markie Cloud, including the ones agents make.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:dev": "tsc --noEmit -p tsconfig.json && vite build --mode dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "mock": "node dev/mock-server.mjs",
    "sync": "npm run build && cap sync",
    "sync:dev": "npm run build:dev && cap sync",
    "ios": "npm run sync && cap run ios",
    "android": "npm run sync && cap run android"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/share": "8.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "glob": "^14.0.3",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
