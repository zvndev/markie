<?xml version="1.0" encoding="utf-8"?>
<!-- The FileProvider Capacitor's share plugin and web view expect to find.
     The app shares links only and has no file inputs, so nothing is written
     here today. If that changes, it is one folder in the app's own cache,
     never external storage or the whole cache. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="shared" path="shared/" />
</paths>
