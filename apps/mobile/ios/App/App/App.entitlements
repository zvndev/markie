<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal links for /d/* and /s/*, once each host serves
	     /.well-known/apple-app-site-association naming 3VU8SG5TD9.com.zvn.markie.mobile. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:api.markiedocs.com</string>
		<string>applinks:markiedocs.com</string>
	</array>
</dict>
</plist>
