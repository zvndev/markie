FROM node:22-alpine
WORKDIR /app

# Reuse the locked server dependencies, but do not execute native-package hooks.
# This isolated gateway never imports auth/database migrations or the public app.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY src/private-releases.ts src/private-release-service.ts ./src/

ENV NODE_ENV=production
EXPOSE 8787
CMD ["node", "--experimental-strip-types", "src/private-release-service.ts"]
