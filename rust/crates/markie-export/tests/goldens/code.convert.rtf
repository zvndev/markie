\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 // Fetch a note and render it\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 import \{ render \} from "./render.js";\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 const MAX = 3, retries = [1, 2.5, 0x1f];\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 export async function load(path, \{ force = false \} = \{\}) \{\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24   const res = await fetch(`/api/notes/$\{path\}?force=$\{force\}`);\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24   if (!res.ok) throw new Error("failed: " + res.status);\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24   return res.json().then((note) => render(note, null, true));\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 \}\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 class Note extends Base \{\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24   constructor(title) \{ super(); this.title = title; \}\par
\pard\ql\sb0\sa120\sl240\slmult1 \plain\f1\fs24 \}\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 interface Note \{ id: string; tags?: string[]; pinned: boolean \}\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 type Id = number | string;\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 function first<T>(items: T[]): T | undefined \{\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24   return items.length > 0 ? items[0] : undefined;\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 \}\par
\pard\ql\sb0\sa120\sl240\slmult1 \plain\f1\fs24 const notes: Note[] = [];\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 import os\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 from pathlib import Path\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f0\fs24 \par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 def count_words(path: str, limit=10) -> int:\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24     """Count the words in a file."""\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24     text = Path(path).read_text()  # read it all\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24     if not text or len(text) > 1_000_000:\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24         return 0\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24     return sum(1 for word in text.split() if word)\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f0\fs24 \par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 class Library(object):\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24     def __init__(self, root=None):\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24         self.root = root or os.getcwd()\par
\pard\ql\sb0\sa120\sl240\slmult1 \plain\f1\fs24         print(f"library at \{self.root\}", True, None)\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 #!/usr/bin/env bash\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 set -euo pipefail\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 for f in "$HOME"/notes/*.md; do\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24   echo "file: $f" | grep -c note || true\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 done\par
\pard\ql\sb0\sa120\sl240\slmult1 \plain\f1\fs24 export PATH="/usr/local/bin:$PATH"\par
