{
  "name": "markie-mobile",
  "version": "0.2.0",
  "private": true,
  "description": "Markie for iOS and Android: open documents from Markie Cloud, including the ones agents make.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:dev": "tsc --noEmit -p tsconfig.json && vite build --mode dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "mock": "node dev/mock-server.mjs",
    "sync": "npm run build && cap sync",
    "sync:dev": "npm run build:dev && cap sync",
    "ios": "npm run sync && cap run ios",
    "android": "npm run sync && cap run android"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "20.19.37",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
