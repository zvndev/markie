{
 "bodyHtml": "<a class=\"wd-skip-link\" href=\"#main\">Skip to content</a>\n<main id=\"main\">\n<h1 id=\"shopping-list\">Shopping list</h1>\n\n<script type=\"application/json\" data-wd-state>{\"shopping\":[{\"item\":\"Bread\",\"price\":4.5,\"got\":false},{\"item\":\"Milk\",\"price\":2,\"got\":true},{\"item\":\"Coffee\",\"price\":12,\"got\":false}]}</script>\n<script type=\"application/json\" data-wd-state>{\"showTotal\":false}</script>\n<script type=\"application/json\" data-wd-state>{\"name\":\"Ada\"}</script>\n<span data-wd-computed data-wd-computed-key=\"title\" data-wd-computed-expr=\"[&quot;+&quot;,[&quot;S&quot;,&quot;name&quot;],[&quot;L&quot;,&quot;&#39;s list&quot;]]\"></span><script type=\"application/json\" data-wd-state>{\"title\":\"Ada's list\"}</script>\n<span data-wd-computed data-wd-computed-key=\"many\" data-wd-computed-expr=\"[&quot;A&quot;,&quot;count&quot;,[&quot;S&quot;,&quot;shopping&quot;]]\"></span><script type=\"application/json\" data-wd-state>{\"many\":3}</script>\n<h2 id=\"adas-list\"><span data-wd-bind=\"title\" data-wd-fmt=\"[[&quot;upper&quot;,[]]]\">ADA&#39;S LIST</span></h2>\n<ul>\n<li><input type=\"checkbox\" disabled checked> Write the list</li>\n<li><input type=\"checkbox\" disabled> Go to the shop</li>\n</ul>\n\n<div data-wd-loop=\"shopping\" data-wd-loop-sort=\"price\" data-wd-loop-sort-dir=\"desc\"><template data-wd-loop-template><div data-wd-loop-piece><p><strong><span data-wd-each data-wd-path=\"item\"></span></strong>: <span data-wd-each data-wd-path=\"price\" data-wd-fmt=\"[[&quot;money&quot;,[]]]\"></span></p>\n\n<span data-wd-each-if data-wd-path=\"got\"><template data-wd-if-true><p>(in the basket)</p></template><template data-wd-if-false><p>(still to buy)</p></template><span data-wd-each-if-out></span></span></div></template><div data-wd-loop-out><div data-wd-loop-key=\"{&quot;item&quot;:&quot;Coffee&quot;,&quot;price&quot;:12,&quot;got&quot;:false}\" data-wd-loop-piece><p><strong><span data-wd-each data-wd-path=\"item\">Coffee</span></strong>: <span data-wd-each data-wd-path=\"price\" data-wd-fmt=\"[[&quot;money&quot;,[]]]\">$12.00</span></p>\n\n<span data-wd-each-if data-wd-path=\"got\"><template data-wd-if-true><p>(in the basket)</p></template><template data-wd-if-false><p>(still to buy)</p></template><span data-wd-each-if-out><p>(still to buy)</p></span></span></div><div data-wd-loop-key=\"{&quot;item&quot;:&quot;Bread&quot;,&quot;price&quot;:4.5,&quot;got&quot;:false}\" data-wd-loop-piece><p><strong><span data-wd-each data-wd-path=\"item\">Bread</span></strong>: <span data-wd-each data-wd-path=\"price\" data-wd-fmt=\"[[&quot;money&quot;,[]]]\">$4.50</span></p>\n\n<span data-wd-each-if data-wd-path=\"got\"><template data-wd-if-true><p>(in the basket)</p></template><template data-wd-if-false><p>(still to buy)</p></template><span data-wd-each-if-out><p>(still to buy)</p></span></span></div><div data-wd-loop-key=\"{&quot;item&quot;:&quot;Milk&quot;,&quot;price&quot;:2,&quot;got&quot;:true}\" data-wd-loop-piece><p><strong><span data-wd-each data-wd-path=\"item\">Milk</span></strong>: <span data-wd-each data-wd-path=\"price\" data-wd-fmt=\"[[&quot;money&quot;,[]]]\">$2.00</span></p>\n\n<span data-wd-each-if data-wd-path=\"got\"><template data-wd-if-true><p>(in the basket)</p></template><template data-wd-if-false><p>(still to buy)</p></template><span data-wd-each-if-out><p>(in the basket)</p></span></span></div></div></div>\n<button type=\"button\" data-wd-action=\"append\" data-wd-target=\"shopping\" data-wd-value=\"{&quot;item&quot;:&quot;Eggs&quot;,&quot;price&quot;:3,&quot;got&quot;:false}\">Add eggs</button>\n<button type=\"button\" data-wd-action=\"toggle\" data-wd-target=\"showTotal\">Toggle total</button>\n<button type=\"button\" data-wd-action=\"clear\" data-wd-target=\"shopping\">Empty the list</button>\n<div data-wd-if=\"showTotal\" data-wd-if-active=\"false\"><template data-wd-true><p>Total: <span data-wd-bind=\"shopping\" data-wd-fmt=\"[[&quot;sum&quot;,[&quot;price&quot;]],[&quot;money&quot;,[]]]\">$18.50</span> for <span data-wd-bind=\"many\">3</span> items.</p></template><template data-wd-false><p>The total is hidden.</p></template><div data-wd-if-out><p>The total is hidden.</p></div></div>\n</main>\n<script type=\"module\" src=\"/__wd/runtime.js\"></script>",
