\pard\ql\sb0\sa0\sl240\slmult1 \plain\f0\fs24 \par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 /// Counts words.\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 fn count(text: &str) -> usize \{\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24     let mut seen: HashMap<String, u32> = HashMap::new();\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24     for word in text.split_whitespace() \{\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24         *seen.entry(word.to_string()).or_insert(0) += 1;\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24     \}\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24     println!("\{\} words", seen.len());\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24     seen.len()\par
\pard\ql\sb0\sa120\sl240\slmult1 \plain\f1\fs24 \}\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 package main\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f0\fs24 \par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 import "fmt"\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f0\fs24 \par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 func main() \{\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 \tab notes := []string\{"a", "b"\}\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 \tab for i, n := range notes \{\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 \tab \tab fmt.Println(i, n, len(n) > 0, nil)\par
\pard\ql\sb0\sa0\sl240\slmult1 \plain\f1\fs24 \tab \}\par
\pard\ql\sb0\sa120\sl240\slmult1 \plain\f1\fs24 \}\par
\pard\ql\sb0\sa120\sl240\slmult1 \plain\f1\fs24 SELECT id, title FROM notes WHERE pinned = TRUE AND views > 10 ORDER BY title;\par
