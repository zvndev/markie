{
  "name": "markie",
  "version": "0.3.2",
  "private": true,
  "description": "A fast, native desktop markdown editor for local files, sharing, and AI agents.",
  "author": "ZVN",
  "license": "MIT",
  "homepage": "https://markie.zvndev.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/zvndev/markie.git"
  },
  "bugs": {
    "url": "https://github.com/zvndev/markie/issues"
  },
  "keywords": [
    "markdown",
    "editor",
    "desktop",
    "windows",
    "linux",
    "electron",
    "mcp"
  ],
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "sync:check": "node scripts/sync-down-check.mjs",
    "comments:verify": "node scripts/comments-verify-local.mjs",
    "comments:verify:e2e": "node scripts/comments-verify-local.mjs --with-e2e",
    "visual:audit:light": "node scripts/light-mode-visual-audit.mjs",
    "visual:guard:theme": "node scripts/light-mode-visual-audit.mjs --regression-guard",
    "visual:check:document": "node scripts/document-canvas-layout-check.mjs",
    "visual:check:overlays": "node scripts/overlay-interaction-check.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "native:restore": "node scripts/restore-host-native-prebuild.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:status": "node scripts/release.mjs status",
    "release:version": "node scripts/release.mjs version",
    "release:prepare:mac": "node scripts/release.mjs prepare mac",
    "release:verify:mac": "node scripts/release.mjs verify-local mac",
    "release:publish:mac": "node scripts/release.mjs publish mac",
    "release:verify:public": "node scripts/release.mjs verify-public mac",
    "release:rollback:mac": "node scripts/release.mjs rollback mac",
    "electron:smoke": "node scripts/package-smoke.mjs",
    "electron:smoke:mac:arm64": "node scripts/package-smoke.mjs --platform mac --arch arm64",
    "electron:smoke:mac:launch": "node scripts/desktop-launch-smoke.mjs --platform mac --arch arm64",
    "electron:smoke:mac:x64": "node scripts/package-smoke.mjs --platform mac --arch x64",
    "electron:smoke:win": "node scripts/package-smoke.mjs --platform windows --arch x64",
    "electron:smoke:win:launch": "node scripts/windows-launch-smoke.mjs",
    "electron:smoke:linux": "node scripts/package-smoke.mjs --platform linux --arch x64",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && NODE_ENV=development electron .\"",
    "electron:build": "npm run build && node scripts/local-electron-builder.mjs --config electron-builder.config.cjs --mac --publish never",
    "electron:build:mac": "npm run build && node scripts/local-electron-builder.mjs --config electron-builder.config.cjs --mac --publish never",
    "electron:build:win": "npm run build && node scripts/local-electron-builder.mjs --config electron-builder.config.cjs --win --publish never",
    "electron:build:linux": "npm run build && node scripts/local-electron-builder.mjs --config electron-builder.config.cjs --linux --publish never",
    "electron:pack": "npm run electron:pack:mac",
    "electron:pack:mac": "npm run build && node scripts/local-electron-builder.mjs --config electron-builder.config.cjs --mac --dir --publish never",
    "electron:pack:mac:arm64": "npm run build && node scripts/local-electron-builder.mjs --config electron-builder.config.cjs --mac --arm64 --dir --publish never",
    "electron:pack:mac:x64": "npm run build && node scripts/local-electron-builder.mjs --config electron-builder.config.cjs --mac --x64 --dir --publish never",
    "electron:pack:win": "npm run build && node scripts/local-electron-builder.mjs --config electron-builder.config.cjs --win --x64 --dir --publish never && node scripts/install-win-native-prebuild.mjs",
    "electron:pack:linux": "npm run build && node scripts/local-electron-builder.mjs --config electron-builder.config.cjs --linux --x64 --dir --publish never",
    "electron:release": "node scripts/release.mjs publish mac",
    "share:check": "node scripts/share-link-check.mjs",
    "reveal:check": "node scripts/reveal-check.mjs",
    "find:check": "node scripts/find-check.mjs",
    "update:check": "node scripts/update-flow-check.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@tailwindcss/postcss": "^4",
    "@tiptap/core": "^3.26.0",
    "@tiptap/extension-collaboration": "^3.26.0",
    "@tiptap/extension-collaboration-caret": "^3.26.0",
    "@tiptap/extension-image": "^3.26.0",
    "@tiptap/extension-placeholder": "^3.26.0",
    "@tiptap/extension-table": "^3.26.0",
    "@tiptap/extension-task-item": "^3.26.0",
    "@tiptap/extension-task-list": "^3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@uiw/react-codemirror": "^4.25.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^9.2.1",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.1",
    "katex": "^0.16.38",
    "next": "16.1.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4",
    "tiptap-markdown": "^0.9.0",
    "typescript": "^5",
    "unified": "^11.0.5",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.4",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31"
  },
  "engines": {
    "node": ">=22"
  }
}
