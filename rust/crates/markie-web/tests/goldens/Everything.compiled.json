{
 "bodyHtml": "<a class=\"wd-skip-link\" href=\"#main\">Skip to content</a>\n<main id=\"main\">\n<h1 id=\"every-darkmown-feature\">Every Darkmown feature</h1>\n<p>A paragraph with <strong>bold</strong>, <em>italic</em>, <code>code</code>, a <a href=\"https://markiedocs.com/docs?a=1\">web link</a> and a <a href=\"mailto:hello@example.com?subject=Hi\">mail link</a>.</p>\n<p>A <a href=\"notes.md\">relative link</a> and a [script link](javascript:alert(1)) are not kept.</p>\n<p><img src=\"pic.png\" alt=\"A picture\" decoding=\"async\" fetchpriority=\"high\"></p>\n<p><img src=\"https://example.com/remote.png\" alt=\"A remote picture\" decoding=\"async\" loading=\"lazy\"></p>\n<blockquote>\n<p>A quote.</p>\n</blockquote>\n<hr>\n\n<script type=\"application/json\" data-wd-state>{\"count\":3}</script>\n<script type=\"application/json\" data-wd-state>{\"name\":\"Ada\"}</script>\n<script type=\"application/json\" data-wd-state>{\"agree\":false}</script>\n<script type=\"application/json\" data-wd-state>{\"size\":\"M\"}</script>\n<script type=\"application/json\" data-wd-state>{\"tone\":\"warm\"}</script>\n<script type=\"application/json\" data-wd-state>{\"items\":[{\"label\":\"Apples\",\"qty\":2},{\"label\":\"Pears\",\"qty\":5},{\"label\":\"Figs\",\"qty\":1}]}</script>\n<script type=\"application/json\" data-wd-state>{\"level\":40}</script><input type=\"range\" data-wd-bind-input=\"level\" min=\"0\" max=\"100\" step=\"5\" value=\"40\" aria-label=\"Level\">\n<span data-wd-computed data-wd-computed-key=\"doubled\" data-wd-computed-expr=\"[&quot;*&quot;,[&quot;S&quot;,&quot;count&quot;],[&quot;L&quot;,2]]\"></span><script type=\"application/json\" data-wd-state>{\"doubled\":6}</script>\n<span data-wd-computed data-wd-computed-key=\"greeting\" data-wd-computed-expr=\"[&quot;+&quot;,[&quot;L&quot;,&quot;Hello, &quot;],[&quot;S&quot;,&quot;name&quot;]]\"></span><script type=\"application/json\" data-wd-state>{\"greeting\":\"Hello, Ada\"}</script>\n<span data-wd-computed data-wd-computed-key=\"total\" data-wd-computed-expr=\"[&quot;A&quot;,&quot;sum&quot;,[&quot;S&quot;,&quot;items&quot;],&quot;qty&quot;]\"></span><script type=\"application/json\" data-wd-state>{\"total\":8}</script>\n<p>Count <span data-wd-bind=\"count\">3</span>, doubled <span data-wd-bind=\"doubled\">6</span>. <span data-wd-bind=\"greeting\">Hello, Ada</span>. Level <span data-wd-bind=\"level\" data-wd-fmt=\"[[&quot;percent&quot;,[]]]\">4,000%</span>. Total <span data-wd-bind=\"total\" data-wd-fmt=\"[[&quot;number&quot;,[]]]\">8</span>.</p>\n\n<button type=\"button\" data-wd-action=\"inc\" data-wd-target=\"count\">Add</button>\n<button type=\"button\" data-wd-action=\"set\" data-wd-target=\"count\" data-wd-value=\"0\">Reset</button>\n<input type=\"text\" data-wd-bind-input=\"name\" value=\"Ada\" aria-label=\"Name\">\n<div class=\"wd-checkboxes\" role=\"group\" aria-label=\"Agree\"><label><input type=\"checkbox\" name=\"agree\" value=\"I agree\" data-wd-bind-input=\"agree\"> I agree</label></div>\n<select data-wd-bind-input=\"size\" aria-label=\"Size\"><option value=\"S\">S</option><option value=\"M\" selected>M</option><option value=\"L\">L</option></select>\n<div class=\"wd-radios\" role=\"radiogroup\" aria-label=\"Tone\"><label><input type=\"radio\" name=\"tone\" value=\"warm\" data-wd-bind-input=\"tone\" checked> warm</label><label><input type=\"radio\" name=\"tone\" value=\"cool\" data-wd-bind-input=\"tone\"> cool</label></div>\n<div data-wd-if=\"agree\" data-wd-if-active=\"false\"><template data-wd-true><p>You agreed.</p></template><template data-wd-false><p>You have not agreed.</p></template><div data-wd-if-out><p>You have not agreed.</p></div></div>\n<div data-wd-loop=\"items\" data-wd-loop-sort=\"qty\" data-wd-loop-sort-dir=\"desc\"><template data-wd-loop-template><li><span data-wd-each data-wd-path=\"label\"></span>: <span data-wd-each data-wd-path=\"qty\"></span></li></template><ul data-wd-loop-out><li data-wd-loop-key=\"{&quot;label&quot;:&quot;Pears&quot;,&quot;qty&quot;:5}\"><span data-wd-each data-wd-path=\"label\">Pears</span>: <span data-wd-each data-wd-path=\"qty\">5</span></li><li data-wd-loop-key=\"{&quot;label&quot;:&quot;Apples&quot;,&quot;qty&quot;:2}\"><span data-wd-each data-wd-path=\"label\">Apples</span>: <span data-wd-each data-wd-path=\"qty\">2</span></li><li data-wd-loop-key=\"{&quot;label&quot;:&quot;Figs&quot;,&quot;qty&quot;:1}\"><span data-wd-each data-wd-path=\"label\">Figs</span>: <span data-wd-each data-wd-path=\"qty\">1</span></li></ul></div>\n<table>\n<thead>\n<tr>\n<th>Item</th>\n<th>Qty</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Count</td>\n<td><span data-wd-bind=\"count\">3</span></td>\n</tr>\n<tr>\n<td>Level</td>\n<td><span data-wd-bind=\"level\">40</span></td>\n</tr>\n</tbody>\n</table>\n\n<script type=\"application/json\" data-wd-state>{\"profile\":null}</script><form data-wd-form=\"profile\"><input type=\"text\" name=\"name\" placeholder=\"Your name\" aria-label=\"Your name\">\n<input type=\"email\" name=\"email\" placeholder=\"Email\" aria-label=\"Email\">\n<button type=\"submit\">Save</button></form>\n<p>Saved: <span data-wd-bind=\"profile\" data-wd-path=\"name\"></span>.</p>\n<pre><code class=\"language-js\"><span class=\"hljs\"><span class=\"hljs-keyword\">const</span> x = <span class=\"hljs-number\">1</span>;\n</span></code></pre>\n\n</main>\n<script type=\"module\" src=\"/__wd/runtime.js\"></script>",
