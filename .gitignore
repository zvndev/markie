# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
!/build/
!/build/preflight.cjs
!/build/entitlements.mac.plist
!/build/icon.ico
!/build/icons/
!/build/icons/*.png

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# electron
/dist/
*.dmg
/.release/

# local dev artifacts
/.playwright-mcp/
marker-screenshot.png

# server
server/node_modules/
server/markie.db*
server/.env
mcp/node_modules/
